{
  "name": "NB_offcl_KB_Tools_EvalSuite",
  "description": "Documentation/knowledge-base tools of nextbillion-mcp: search_documentation, get_documentation, list_documentation_topics, get_api_parameters. Same prompts as NB_Drk_KB_Tools_EvalSuite for the 3 shared tools. Model: Claude Sonnet 4.5.",
  "servers": [
    "nextbillion-mcp"
  ],
  "model": "anthropic/claude-sonnet-4.5",
  "cases": [
    {
      "title": "01 Search docs: avoid toll roads in Flutter SDK",
      "runs": 1,
      "steps": [
        {
          "id": "step-1",
          "kind": "prompt",
          "prompt": "Search the NextBillion documentation for how to avoid toll roads in the Flutter SDK."
        },
        {
          "id": "step-expect-0",
          "kind": "assert",
          "assertion": {
            "type": "toolCalledWith",
            "toolName": "search_documentation",
            "args": {
              "args": {},
              "argumentMatching": "partial"
            }
          }
        },
        {
          "id": "step-expect-1",
          "kind": "assert",
          "assertion": {
            "type": "toolResultContains",
            "needle": "toll",
            "caseSensitive": false,
            "toolName": "search_documentation",
            "role": "advisory"
          }
        },
        {
          "id": "step-expect-2",
          "kind": "assert",
          "assertion": {
            "type": "noToolErrors"
          }
        }
      ]
    },
